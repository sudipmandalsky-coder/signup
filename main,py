liimport customtkinter as ctk
import sqlite3
from tkinter import messagebox

# ---------------------------
# Database Setup
# ---------------------------
def setup_db():
    conn = sqlite3.connect("users.db")
    cur = conn.cursor()
    cur.execute("""
        CREATE TABLE IF NOT EXISTS users (
            username TEXT PRIMARY KEY,
            password TEXT NOT NULL
        )
    """)
    conn.commit()
    conn.close()

setup_db()

# ---------------------------
# Utility DB Functions
# ---------------------------
def add_user(username, password):
    conn = sqlite3.connect("users.db")
    cur = conn.cursor()
    try:
        cur.execute("INSERT INTO users VALUES (?, ?)", (username, password))
        conn.commit()
        return True
    except:
        return False
    finally:
        conn.close()

def check_user(username, password):
    conn = sqlite3.connect("users.db")
    cur = conn.cursor()
    cur.execute("SELECT * FROM users WHERE username=? AND password=?", (username, password))
    result = cur.fetchone()
    conn.close()
    return result

def user_exists(username):
    conn = sqlite3.connect("users.db")
    cur = conn.cursor()
    cur.execute("SELECT * FROM users WHERE username=?", (username,))
    result = cur.fetchone()
    conn.close()
    return result


# ---------------------------
# Base App Window
# ---------------------------
ctk.set_default_color_theme("blue")  # theme
ctk.set_appearance_mode("light")     # light/dark


class App(ctk.CTk):
    def __init__(self):
        super().__init__()

        self.title("Modern Login System")
        self.geometry("500x400")

        self.current_frame = None
        self.switch_frame(LoginPage)

    def switch_frame(self, frame_class):
        """Destroys current frame and replaces it with new one."""
        new_frame = frame_class(self)
        if self.current_frame is not None:
            self.current_frame.destroy()
        self.current_frame = new_frame
        self.current_frame.pack(fill="both", expand=True)


# ---------------------------
# Login Page
# ---------------------------
class LoginPage(ctk.CTkFrame):
    def __init__(self, master):
        super().__init__(master)

        ctk.CTkLabel(self, text="Login", font=("Arial", 26, "bold")).pack(pady=20)

        self.username = ctk.CTkEntry(self, width=250, placeholder_text="Username")
        self.username.pack(pady=10)

        self.password = ctk.CTkEntry(self, width=250, placeholder_text="Password", show="*")
        self.password.pack(pady=10)

        # Show / Hide Password Toggle
        self.show_pwd = ctk.CTkCheckBox(self, text="Show Password", command=self.toggle_password)
        self.show_pwd.pack()

        ctk.CTkButton(self, text="Login", width=200, command=self.login).pack(pady=20)
        ctk.CTkButton(self, text="Create Account", command=lambda: master.switch_frame(SignupPage)).pack()
        ctk.CTkButton(self, text="Forgot Password?", fg_color="gray30",
                      command=lambda: master.switch_frame(ForgotPassword)).pack(pady=5)

        # Theme Switch (Light/Dark)
        self.theme_switch = ctk.CTkSwitch(self, text="Dark Mode", command=self.change_theme)
        self.theme_switch.pack(pady=10)

    def toggle_password(self):
        if self.show_pwd.get() == 1:
            self.password.configure(show="")
        else:
            self.password.configure(show="*")

    def change_theme(self):
        ctk.set_appearance_mode("dark" if self.theme_switch.get() == 1 else "light")

    def login(self):
        user = self.username.get()
        pwd = self.password.get()

        if check_user(user, pwd):
            messagebox.showinfo("Success", "Login Successful!")
        else:
            messagebox.showerror("Failed", "Invalid Username or Password")


# ---------------------------
# Signup Page
# ---------------------------
class SignupPage(ctk.CTkFrame):
    def __init__(self, master):
        super().__init__(master)

        ctk.CTkLabel(self, text="Create Account", font=("Arial", 26, "bold")).pack(pady=20)

        self.username = ctk.CTkEntry(self, width=250, placeholder_text="New Username")
        self.username.pack(pady=10)

        self.password = ctk.CTkEntry(self, width=250, placeholder_text="New Password", show="*")
        self.password.pack(pady=10)

        self.show_pwd = ctk.CTkCheckBox(self, text="Show Password", command=self.toggle_password)
        self.show_pwd.pack()

        ctk.CTkButton(self, text="Signup", width=200, command=self.signup).pack(pady=20)
        ctk.CTkButton(self, text="Back to Login",
                      command=lambda: master.switch_frame(LoginPage)).pack()

    def toggle_password(self):
        if self.show_pwd.get() == 1:
            self.password.configure(show="")
        else:
            self.password.configure(show="*")

    def signup(self):
        user = self.username.get()
        pwd = self.password.get()

        if user_exists(user):
            messagebox.showerror("Error", "Username already exists!")
            return

        if add_user(user, pwd):
            messagebox.showinfo("Success", "Account Created Successfully!")
        else:
            messagebox.showerror("Error", "Something went wrong!")


# ---------------------------
# Forgot Password Page
# ---------------------------
class ForgotPassword(ctk.CTkFrame):
    def __init__(self, master):
        super().__init__(master)

        ctk.CTkLabel(self, text="Forgot Password", font=("Arial", 26, "bold")).pack(pady=20)

        self.username = ctk.CTkEntry(self, width=250, placeholder_text="Enter Username")
        self.username.pack(pady=10)

        self.new_password = ctk.CTkEntry(self, width=250, placeholder_text="New Password", show="*")
        self.new_password.pack(pady=10)

        self.show_pwd = ctk.CTkCheckBox(self, text="Show Password", command=self.toggle_password)
        self.show_pwd.pack()

        ctk.CTkButton(self, text="Reset Password", width=200, command=self.reset_password).pack(pady=20)

        ctk.CTkButton(self, text="Back to Login",
                      command=lambda: master.switch_frame(LoginPage)).pack()

    def toggle_password(self):
        if self.show_pwd.get() == 1:
            self.new_password.configure(show="")
        else:
            self.new_password.configure(show="*")

    def reset_password(self):
        user = self.username.get()
        new_pwd = self.new_password.get()

        if not user_exists(user):
            messagebox.showerror("Error", "Username not found!")
            return

        conn = sqlite3.connect("users.db")
        cur = conn.cursor()
        cur.execute("UPDATE users SET password=? WHERE username=?", (new_pwd, user))
        conn.commit()
        conn.close()

        messagebox.showinfo("Success", "Password Reset Successfully!")


